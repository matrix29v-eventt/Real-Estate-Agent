# ---------------------------------------------------------------------------
# LLM configuration for the Real Estate Lead Qualification Agent
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Which provider the agent should use: "anthropic" | "ollama" | "auto"
# "auto" picks Anthropic if a key is present, otherwise tries a local Ollama.
LLM_PROVIDER=auto

# --- Anthropic (cloud) ------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Ollama (optional local fallback) ---------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Application ------------------------------------------------------------
# Override the SQLite file location (optional)
REALESTATE_DB=
# Seconds before an LLM call is abandoned
LLM_TIMEOUT_SECONDS=90
