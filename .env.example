# LLM Configuration
# Option 1: OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Set LLM_PROVIDER to "openai" or "ollama"
LLM_PROVIDER=openai

# Optional: Set to "ollama" to use local model when OpenAI key is not available
# If no LLM is configured, the app will show a warning and use rule-based fallback
