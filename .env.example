# ---------------------------------------------------------------------------
# LLM configuration for the Real Estate Lead Qualification Agent
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Which provider the agent should use: "gemini" | "anthropic" | "ollama" | "auto"
# "auto" tries Gemini, then Anthropic, then local Ollama.
LLM_PROVIDER=auto

# --- Gemini (Google AI Studio free tier, subject to quotas) ------------------
# Create a key at https://aistudio.google.com/apikey; keep billing disabled for free usage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic (cloud) ------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Ollama (optional local fallback) ---------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Demo access control ----------------------------------------------------
# Shared code that unlocks the broker view. This is a demo role switch, NOT a
# security system: there are no user accounts and no passwords are stored.
# Buyers sign in with a display name only.
BROKER_ACCESS_CODE=broker123

# --- Application ------------------------------------------------------------
# Override the SQLite file location (optional)
REALESTATE_DB=
# Seconds before an LLM call is abandoned
LLM_TIMEOUT_SECONDS=90
